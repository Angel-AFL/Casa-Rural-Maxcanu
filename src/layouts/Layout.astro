---
import ClientRouter from "astro/components/ClientRouter.astro";
import "../styles/global.css";
export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title = "Casa Rural Maxcanú",
  description = "Disfruta de la tranquilidad en Casa Rural Maxcanú. Hospedaje, renta de bicicletas, galería de arte y jardín botánico en el corazón de Yucatán.",
  image = "/logo-casa-rural-horizontal-variante.jpg",
} = Astro.props;
const currentPath = Astro.url.pathname;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const keywords =
  "Casa Rural Maxcanú, hospedaje en Yucatán, renta de bicicletas Maxcanú, turismo rural México, jardín botánico Yucatán, galería de arte Maxcanú, ecoturismo";
const author = "Casa Rural Maxcanú";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={author} />
    <meta name="publisher" content={author} />
    <meta name="robots" content="index, follow" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/logo-casa-rural-icono-negativo.png"
    />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BedAndBreakfast",
        "name": "Casa Rural Maxcanú",
        "description": "Hospedaje, renta de bicicletas y jardín botánico en Yucatán.",
        "image": "https://casa-rural-maxcanu.vercel.app/logo-casa-rural-horizontal-variante.jpg",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "C. 25 84, Centro",
          "addressLocality": "Maxcanú",
          "addressRegion": "Yucatán",
          "postalCode": "97800",
          "addressCountry": "MX"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 20.5833,
          "longitude": -90.0
        },
        "url": "https://casa-rural-maxcanu.vercel.app/",
        "telephone": "+529999062536"
      }
    </script>
    <ClientRouter />

    <style>
      nav a {
        position: relative;
        text-decoration: none;
        transition: color 0.3s ease-in-out;
      }

      nav a::after {
        content: "";
        position: absolute;
        width: 100%;
        height: 1px;
        background-color: #a38613;
        bottom: -2px;
        left: 0;
        transform: scaleX(0);
        transform-origin: bottom left;
        transition: transform 0.3s ease-in-out;
      }

      nav a:hover,
      nav a.active-link {
        color: #a38613;
      }

      nav a:hover::after,
      nav a.active-link::after {
        transform: scaleX(1);
      }

      footer ul li a {
        position: relative;
        text-decoration: none;
        transition: color 0.3s ease-in-out;
      }

      footer ul li a::after {
        content: "";
        position: absolute;
        width: 100%;
        height: 1px;
        background-color: white;
        bottom: -2px;
        left: 0;
        transform: scaleX(0);
        transform-origin: bottom left;
        transition: transform 0.3s ease-in-out;
      }

      footer ul li a:hover {
        color: white;
      }

      footer ul li a:hover::after {
        transform: scaleX(1);
      }
    </style>
    <script>
      function setupMobileMenu() {
        const $mobileMenuBtn = document.getElementById("mobileMenuBtn");
        const $closeMenuBtn = document.getElementById("closeMenuBtn");
        const $mobileMenu = document.getElementById("mobileMenu");
        const $menuLinks = document.querySelectorAll("#mobileMenu a");
        const $body = document.body;

        // Función para abrir/cerrar con bloqueo de scroll
        const toggleMenu = () => {
          // Si el menú tiene la clase 'translate-x-full', significa que está CERRADO y se va a ABRIR
          const isOpening = $mobileMenu?.classList.contains("translate-x-full");

          $mobileMenu?.classList.toggle("translate-x-full");

          if (isOpening) {
            $body.classList.add("overflow-hidden");
          } else {
            $body.classList.remove("overflow-hidden");
          }
        };

        // Función específica para cerrar (útil para los enlaces)
        const closeMenu = () => {
          $mobileMenu?.classList.add("translate-x-full");
          $body.classList.remove("overflow-hidden");
        };

        $mobileMenuBtn?.addEventListener("click", toggleMenu);
        $closeMenuBtn?.addEventListener("click", toggleMenu);

        // Al hacer clic en cualquier enlace, cerramos el menú y devolvemos el scroll
        $menuLinks.forEach((link) => {
          link.addEventListener("click", closeMenu);
        });
      }

      // Se ejecuta en la carga inicial y después de cada transición de página en Astro
      document.addEventListener("astro:page-load", setupMobileMenu);

      // Limpieza preventiva por si se desmonta el componente (opcional pero recomendado)
      document.addEventListener("astro:before-swap", () => {
        document.body.classList.remove("overflow-hidden");
      });
    </script>
  </head>
  <body
    class="font-[montserrat] font-medium pt-[84px] md:pt-[70px] lg:pt-[84px]"
  >
    <header class="bg-palette-1 fixed top-0 w-full z-50 text-white">
      <div
        class="flex md:flex md:gap-4 lg:gap-0 justify-around items-center text-center"
      >
        <a href="/">
          <img
            src="/logo-casa-rural-variante.png"
            alt="logo"
            width="84"
            height="84"
          />
        </a>

        <nav class="md:block hidden">
          <ul class="md:flex md:items-center lg:gap-8 md:gap-4">
            <li>
              <a href="/" class={currentPath === "/" ? "active-link" : ""}
                >Inicio</a
              >
            </li>
            <li>
              <a
                href="/nosotros"
                class={currentPath === "/nosotros" ? "active-link" : ""}
                >Nosotros</a
              >
            </li>
            <li>
              <a
                href="/hospedaje"
                class={currentPath === "/hospedaje" ? "active-link" : ""}
                >Hospedaje</a
              >
            </li>
            <li>
              <a
                href="/renta-de-bicicletas"
                class={currentPath === "/renta-de-bicicletas"
                  ? "active-link"
                  : ""}>Renta de bicicletas</a
              >
            </li>
            <li>
              <a
                href="/galeria-de-arte"
                class={currentPath === "/galeria-de-arte" ? "active-link" : ""}
                >Galería de arte</a
              >
            </li>
            <li>
              <a
                href="/galeria-virtual"
                class={currentPath === "/galeria-virtual" ? "active-link" : ""}
                >Galería virtual</a
              >
            </li>
            <li>
              <a
                href="/jardin-botanico"
                class={currentPath === "/jardin-botanico" ? "active-link" : ""}
                >Jardín botánico</a
              >
            </li>
          </ul>
        </nav>
        <!--Menú Móvil-->
        <div id="mobileMenuBtn" class="md:hidden">
          <img
            src="/MaterialSymbolsMenu.svg"
            alt="menú móvil"
            width="36"
            height="36"
          />
        </div>
        <div
          id="mobileMenu"
          class="fixed inset-0 bg-palette-1 z-[60] flex flex-col items-center justify-center transition-transform duration-300 translate-x-full md:hidden"
        >
          <button
            id="closeMenuBtn"
            class="absolute top-6 right-8 text-white text-4xl">&times;</button
          >

          <ul class="flex flex-col gap-8 text-center text-xl text-white">
            <li>
              <a href="/" class={currentPath === "/" ? "text-[#a38613]" : ""}
                >Inicio</a
              >
            </li>
            <li>
              <a
                href="/nosotros"
                class={currentPath === "/nosotros" ? "text-[#a38613]" : ""}
                >Nosotros</a
              >
            </li>
            <li>
              <a
                href="/hospedaje"
                class={currentPath === "/hospedaje" ? "text-[#a38613]" : ""}
                >Hospedaje</a
              >
            </li>
            <li>
              <a
                href="/renta-de-bicicletas"
                class={currentPath === "/renta-de-bicicletas"
                  ? "text-[#a38613]"
                  : ""}>Renta de bicicletas</a
              >
            </li>
            <li>
              <a
                href="/galeria-de-arte"
                class={currentPath === "/galeria-de-arte"
                  ? "text-[#a38613]"
                  : ""}>Galería de arte</a
              >
            </li>
            <li>
              <a
                href="/galeria-virtual"
                class={currentPath === "/galeria-virtual"
                  ? "text-[#a38613]"
                  : ""}>Galería virtual</a
              >
            </li>
            <li>
              <a
                href="/jardin-botanico"
                class={currentPath === "/jardin-botanico"
                  ? "text-[#a38613]"
                  : ""}>Jardín botánico</a
              >
            </li>
          </ul>
        </div>
        <!--Fin Menú Móvil-->
      </div>
    </header>
    <main>
      <slot />
    </main>

    <footer class="bg-palette-2 p-2 md:p-4 lg:p-8">
      <div class="flex flex-col md:flex-row justify-evenly md:gap-8 lg:gap-1">
        <div class="flex flex-col gap-2 flex-1 items-center">
          <div class="flex flex-col gap-2">
            <div>
              <img
                src="/logo-casa-rural-texto-negativo.png"
                alt="Logotipo de la Casa Rural Maxcanú"
                width="100"
                height="100"
              />
            </div>
            <span class="text-lg">Casa Rural Maxcanú</span>
            <ul>
              <li>
                <span
                  ><a
                    href="https://maps.app.goo.gl/QbSrKrBu61NDQguR9"
                    target="_blank"
                    rel="noopener noreferrer"
                    >Dirección: 97800, C. 25 84, Centro, Maxcanú, Yucatán.</a
                  ></span
                >
              </li>
              <li>
                <span
                  ><a href="mailto:casarural@gmail.com"
                    >Correo: casarural@gmail.com</a
                  ></span
                >
              </li>
              <li>
                <span
                  ><a
                    href="https://wa.me/+529999062536
            "
                    target="_blank"
                    rel="noopener noreferrer">Teléfono: +529999062536</a
                  ></span
                >
              </li>
            </ul>
          </div>
        </div>

        <div class="pt-6 flex flex-col gap-2 flex-1 md:items-center">
          <ul class="flex flex-col gap-2">
            <li><span class="text-lg">Acerca de</span></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/hospedaje">Hospedaje</a></li>
            <li><a href="/renta-de-bicicletas">Renta de bicicletas</a></li>
            <li><a href="/galeria-de-arte">Galería de arte</a></li>
            <li><a href="/galeria-virtual">Galería virtual</a></li>
          </ul>
        </div>

        <div class="pt-6 flex flex-col gap-2 flex-1 md:items-center">
          <ul class="flex flex-col gap-2">
            <li><span class="text-lg">Ayuda</span></li>
            <li><a href="/preguntas-frecuentes">Preguntas frecuentes</a></li>
            <li><a href="/mas-servicios">Atractivos turísticos</a></li>
          </ul>
        </div>

        <div class="pt-6 flex flex-col gap-2 flex-1 md:items-center">
          <ul class="flex flex-col gap-2">
            <li><span class="text-lg">Políticas</span></li>
            <li>
              <a href="/politicas/terminos-y-condiciones"
                >Términos y condiciones</a
              >
            </li>
            <li>
              <a href="/politicas/politica-de-privacidad"
                >Política de privacidad</a
              >
            </li>
          </ul>
        </div>

        <div class="pt-6 flex flex-col gap-4 flex-1 md:items-center">
          <span class="text-lg">Redes Sociales</span>
          <ul class="flex gap-4 md:w-36 lg:w-48">
            <li>
              <a
                href="https://wa.me/+529999062536
            "
                target="_blank"
                rel="noopener noreferrer"
                aria-label="WhatsApp"
                ><img
                  src="/whatsapp-icon.png"
                  alt="ícono de whatsapp"
                  width="38"
                  height="38"
                  class="hover:invert transition-all duration-300"
                /></a
              >
            </li>
            <li>
              <a
                href="https://www.facebook.com/share/17ZH6uVrJm/?mibextid=wwXIfr"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Facebook"
              >
                <img
                  src="/facebook-icon.png"
                  alt="ícono de facebook"
                  width="38"
                  height="38"
                  class="hover:invert transition-all duration-300"
                />
              </a>
            </li>
            <li>
              <a
                href="https://www.instagram.com/casarural.maxcanu"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
              >
                <img
                  src="/instagram-icon.png"
                  alt="ícono de instagram"
                  width="38"
                  height="38"
                  class="hover:invert transition-all duration-300"
                />
              </a>
            </li>
            <li>
              <a
                href="https://www.tiktok.com/@casarural.maxcanu"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Tiktok"
              >
                <img
                  src="/tiktok-icon.png"
                  alt="ícono de tiktok"
                  width="38"
                  height="38"
                  class="hover:invert transition-all duration-300"
                />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
