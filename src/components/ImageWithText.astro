---
export interface Props {
  heading?: string;
  subheading?: string;
  text?: string;
  imageUrl?: string;
  imageSide?: "left" | "right";
}

const { heading, subheading, text, imageUrl, imageSide = "left" } = Astro.props;
---

<section
  class={`w-full flex flex-col ${imageSide === "right" ? "md:flex-row-reverse" : "md:flex-row"} my-8`}
>
  <div class="md:w-1/2 overflow-hidden">
    <img
      class="w-full h-full lg:h-[500px] hover:scale-105 transition duration-300"
      src={imageUrl}
      alt=""
    />
  </div>
  <div class="md:w-1/2 bg-palette-2 text-white">
    <div class="flex flex-col h-full gap-4 p-8 justify-center items-center">
      <h2 class="text-2xl font-semibold">{heading}</h2>
      <h3 class="text-sm font-medium">{subheading}</h3>
      <p>{text}</p>
    </div>
  </div>
</section>
