---
export interface Props {
  heading?: string;
  headingColor?: string;
  subheading?: string;
  subheadingColor?: string;
  text?: string;
  textColor?: string;
  imageUrl?: string;
  imageSide?: "left" | "right";
  bgColor?: string;
}

const {
  heading,
  headingColor = "text-white",
  subheading,
  subheadingColor = "text-white",
  text,
  textColor = "text-white",
  imageUrl,
  imageSide = "left",
  bgColor = "bg-palette-2",
} = Astro.props;
---

<section
  class={`w-full flex flex-col ${imageSide === "right" ? "md:flex-row-reverse" : "md:flex-row"} my-8`}
>
  <div class="md:w-1/2 overflow-hidden">
    <img
      class="w-full h-full lg:h-[500px] hover:scale-105 transition duration-300"
      src={imageUrl}
      alt=""
    />
  </div>
  <div class={`md:w-1/2 text-white ${bgColor}`}>
    <div class="flex flex-col h-full gap-4 p-8 justify-center items-center">
      <h2 class={`text-2xl font-semibold ${headingColor}`}>{heading}</h2>
      <h3 class={`text-sm font-medium ${subheadingColor}`}>{subheading}</h3>
      <p class={textColor}>{text}</p>
    </div>
  </div>
</section>
