---
const {
	label = '',
	bgColor = 'bg-palette-2',
	textColor = 'text-palette-4',
	href = '/',
	
} = Astro.props;
---

<button
	type="button"
	 onclick={`window.location.href='${href}'`}
	class={`flex items-center gap-2 w-auto max-w-[580px] rounded-3xl font-bold py-2 px-8 cursor-pointer ${bgColor} ${textColor} transition duration-100 ease-in-out transform hover:scale-110 hover:text-white`}>
	{label}
	
</button>