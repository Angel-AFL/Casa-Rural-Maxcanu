---
const {
	label = '',
	bgColor = 'bg-palette-1',
	textColor = 'text-black',
	
} = Astro.props;
---

<button
	type="submit"
	class={`flex items-center gap-2 w-auto max-w-[580px] rounded-2xl font-medium py-2 px-4 cursor-pointer ${bgColor} ${textColor} transition duration-100 ease-in-out transform hover:scale-205 hover:text-white`}>
	
	<slot>{label}</slot>
</button>