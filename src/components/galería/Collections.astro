---
import { getCatSalas } from "../../pages/api/cat_sala";
import { getHref } from "../../lib/utils";
import SalaCard from "../galería/SalaCard.astro";

const catSala = await getCatSalas();
---

<section class="p-2 md:p-4 lg:p-8 grid place-items-cente bg-palette-4">
  <div class="grid gap-8 lg:grid-cols-3 md:grid-cols-2">
    {
      catSala?.map((sala) => (
        <SalaCard
          href={getHref(sala.nombre)}
          image={sala.imagen}
          name={sala.nombre}
        />
      ))
    }
  </div>
</section>
