---
export interface Props {
  nombre: string;
  autor: string;
  técnica: string;
  categoría: string;
  dimensiones: string;
  anio: string;
  procedencia: string;
  uso: string;
  imagen: string;
}

const {
  nombre = "Sin nombre",
  autor = "Sin autor",
  técnica = "No disponible",
  categoría = "Sin categoría",
  dimensiones = "No disponible",
  anio = "Sin año",
  procedencia = "Desconocido",
  uso = "Sin uso",
  imagen,
} = Astro.props;
---

<!-- Cards -->
<div class="card-with-modal shadow-lg rounded-xl">
  <div class="overflow-hidden rounded-t-xl">
    <img
      src={imagen}
      alt={nombre}
      class="w-full h-96 hover:scale-105 transition duration-300 open-modal-btn cursor-pointer"
    />
  </div>
  <div class="flex flex-col justify-start items-start gap-1.5 p-4">
    <h3 class="font-bold">{nombre}</h3>
    <h3 class="text-sm">{autor}</h3>
    <button
      id="openModal"
      type="submit"
      class="open-modal-btn bg-palette-2 text-white px-4 py-1 rounded-2xl cursor-pointer transition duration-300 ease-in-out transform hover:scale-105"
    >
      Ver más
    </button>
  </div>
  <!-- Fin Cards -->

  <!-- Ventana Modal -->
  <dialog
    class="art-card-dialog p-6 rounded-lg shadow-xl w-11/12 max-w-lg m-auto backdrop:bg-black/60"
  >
    <div class="flex flex-col gap-4">
      <img
        src={imagen}
        alt={imagen}
        class="w-full h-auto max-h-[50vh] object-contain rounded-lg"
      />
      <h3 class="text-2xl font-bold">{nombre}</h3>
      <p class="text-lg"><span class="font-bold">Autor:</span> {autor}</p>
      <p class="text-lg"><span class="font-bold">Técnica:</span> {técnica}</p>
      <p class="text-lg">
        <span class="font-bold">Categoría:</span>
        {categoría}
      </p>
      <p class="text-lg">
        <span class="font-bold">Dimensiones:</span>
        {dimensiones}
      </p>
      <p class="text-lg"><span class="font-bold">Año:</span> {anio}</p>
      <p class="text-lg">
        <span class="font-bold">Procedencia:</span>
        {procedencia}
      </p>
      <p class="text-lg"><span class="font-bold">Uso:</span> {uso}</p>

      <button
        type="button"
        class="close-modal-btn mt-4 bg-palette-1 hover:bg-red-700 text-white px-4 py-1 rounded-2xl cursor-pointer transition duration-300 ease-in-out transform hover:scale-105 self-end"
      >
        Cerrar
      </button>
    </div>
  </dialog>
</div>

<script>
  function setupModals() {
    const cards = document.querySelectorAll(".card-with-modal");

    cards.forEach((card) => {
      if (card.hasAttribute("data-modal-setup")) return;

      const openButtons = card.querySelectorAll(".open-modal-btn");
      const closeButton = card.querySelector(".close-modal-btn");
      const dialog = card.querySelector(
        ".art-card-dialog"
      ) as HTMLDialogElement;

      const openModal = () => {
        dialog.showModal();
        document.body.classList.add("overflow-hidden");
      };

      const closeModal = () => {
        dialog.close();
        // Solo quitamos la clase si no hay otros modales abiertos
        if (document.querySelectorAll("dialog[open]").length === 0) {
          document.body.classList.remove("overflow-hidden");
        }
      };

      if (openButtons.length > 0 && dialog && closeButton) {
        openButtons.forEach((btn) => {
          btn.addEventListener("click", openModal);
        });

        closeButton.addEventListener("click", closeModal);

        // Cerrar al hacer click en el backdrop
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) {
            closeModal();
          }
        });

        // Manejar el cierre con la tecla Escape (nativo de dialog)
        dialog.addEventListener("cancel", () => {
          document.body.classList.remove("overflow-hidden");
        });

        card.setAttribute("data-modal-setup", "true");
      }
    });
  }

  // Ejecutar en carga inicial y en transiciones de Astro
  setupModals();
  document.addEventListener("astro:page-load", setupModals);
</script>
<!-- Fin Vetana Modal -->
