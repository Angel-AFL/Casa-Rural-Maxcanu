---
const { nombre, imagen } = Astro.props;
---

<div class="relative inline-block card-with-modal">

  <!-- Imagen -->
  <img
    src={imagen}
    alt={nombre}
    class="w-[800px] h-[300px] rounded-xl object-cover shadow-md  hover:scale-105 transition-transform duration-300"
  />
</div>



<style>
  .art-card-dialog::backdrop {
    background: rgba(9, 8, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  dialog.art-card-dialog {
    border: 10;
    padding: 10;
    max-width: 90%;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>
