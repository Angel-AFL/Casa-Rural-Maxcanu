---
import { getImgCabanaHabitacion } from "../../pages/api/img_cabana_habitacion";
import type { ImgCabanaHabitacion } from "../../types/global";

let imagenes: ImgCabanaHabitacion[] = [];

try {
  imagenes = await getImgCabanaHabitacion();
} catch (error) {
  console.error("Error fetching imagenes:", error);
}

const urls = imagenes.map((h) => h.imagen);
---

<div class="relative w-full h-screen overflow-hidden">
  <div class="flex w-[600%] animate-slide" style="animation: slide 30s infinite linear;">
    {urls.map((src, i) => (
      <img
        src={src}
        alt={`Imagen ${i + 1}`}
        class="w-full h-screen object-cover flex-shrink-0"
      />
    ))}
  </div>
  <div class="absolute inset-0 bg-black/40 flex flex-col items-center justify-center text-center text-white p-4">
    <h2 class="text-4xl md:text-5xl font-bold mb-4 drop-shadow-lg">Hospedaje</h2>
    <p class="text-lg md:text-xl mb-8 max-w-2xl mx-auto leading-relaxed drop-shadow-md">Registra tu hospedaje aquí</p>

    <button class="bg-[#A38613] text-white font-semibold px-6 py-3 rounded-full shadow-lg hover:scale-105 transition-transform duration-300"
      onclick="document.getElementById('formulario').scrollIntoView({ behavior: 'smooth' });">Registrarse</button>
  </div>
</div>

<style>
  @keyframes slide {
    0% { transform: translateX(0%); }
    16.6% { transform: translateX(-100%); }
    33.2% { transform: translateX(-200%); }
    49.8% { transform: translateX(-300%); }
    66.4% { transform: translateX(-400%); }
    83% { transform: translateX(-500%); }
    100% { transform: translateX(0%); }
  }
</style>
