---
import type { CabanaHabitacion } from "../../types/global";

const { cabanas } = Astro.props;
---

<section class="mt-20">
  <div class="max-w-6xl mx-auto px-4 text-center mb-12">
    <h2 class="text-3xl md:text-4xl font-bold text-emerald-700">
      Nuestras Habitaciones
    </h2>
  </div>

  <section
    id="catalogo"
    class="max-w-7xl mx-auto p-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8"
  >
    {cabanas.map((cabana: CabanaHabitacion) => (
      <article class="rounded-xl shadow-lg overflow-hidden bg-gray-100 text-black">

        <!-- IMAGEN -->
        <div class="overflow-hidden">
          <img
            src={encodeURI(cabana.imagen)}
            alt={cabana.nombre}
            class="h-56 w-full object-cover transition-transform duration-300 hover:scale-105"
          />
        </div>

        <!-- CONTENIDO -->
        <div class="p-5">
          <h3 class="text-xl font-bold mb-2">
            {cabana.nombre}
          </h3>

          <!-- BLOQUE DESPLEGABLE -->
          <div
            class="detalle overflow-hidden transition-all duration-500 ease-in-out max-h-20 opacity-80"
            data-detalle={cabana.id}
          >
            <p class="text-gray-700 leading-relaxed">
              <strong>Descripción:</strong> {cabana.descripcion}
            </p>

            <p class="text-gray-700 leading-relaxed mt-2">
              <strong>Interior:</strong> {cabana.interior}
            </p>
          </div>

          <!-- VER MÁS -->
          <a
            href="#"
            class="ver-mas mt-3 inline-block text-[#7F2E2C] font-semibold underline underline-offset-4"
            data-id={cabana.id}
          >
            Ver más
          </a>
        </div>
      </article>
    ))}
  </section>
</section>

<script>
  const initVerMas = () => {
    const botones = document.querySelectorAll(".ver-mas");
    const detalles = document.querySelectorAll(".detalle");

    botones.forEach((btn) => {
      const boton = btn instanceof HTMLElement ? btn : null;
      if (!boton) return;

      if (boton.dataset.ready) return;
      boton.dataset.ready = "true";

      boton.addEventListener("click", (e) => {
        e.preventDefault();

        const id = boton.dataset.id;
        if (!id) return;

        const actual = document.querySelector(`[data-detalle="${id}"]`);

        detalles.forEach((det) => {
          if (det !== actual) {
            det.classList.remove("open");
          }
        });

        if (actual instanceof HTMLElement) {
          const abierto = actual.classList.toggle("open");
          boton.textContent = abierto ? "Ver menos" : "Ver más";
        }
      });
    });
  };

  initVerMas();
  document.addEventListener("astro:page-load", initVerMas);
</script>

<style>
  /* estado cerrado: solo se asoma el texto */
  .detalle {
    max-height: 5rem;
  }

  /* estado abierto */
  .detalle.open {
    max-height: 500px;
    opacity: 1;
  }
</style>
