---
const { 
  title = "Descubre los secretos de Maxcanú y la Ruta Puuc", 
  subtitle = "Explora grutas milenarias, haciendas históricas y la riqueza cultural de la región.", 
  imageUrl = "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/casa-rural.png" 
} = Astro.props;

const atractivos = {
  arqueologia: [
    {
      id: 1,
      title: "Zona Arqueológica de Oxkintok",
      description: "Ciudad maya ocupada desde el siglo I hasta el XVI. Destaca el laberinto ceremonial subterráneo Satunsat y los conjuntos arquitectónicos de los linajes gobernantes, es ideal para visitar durante los equinoccios",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/oxkintok.jpg",
      link: "https://inah.gob.mx/zonas/zona-arqueologica-de-oxkintok",
      tags: ["Arqueología", "Equinoccios", "Maya"]
    },
    {
      id: 2,
      title: "Iglesia de San Miguel Arcángel",
      description: "Construida a fines del siglo XVII, conserva un altar mayor con retablo de cedro tallado con relieves dorados. Su campanario de cuatro arcos con cinco campanas regulaba la vida diaria en Maxcanú.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/santa-barbara.jpg",
      link: "#",
      tags: ["Arqueología", "Iglesia", "Paraíso"]
    },
    {
      id: 3,
      title: "Juego de Pelota Maya",
      description: "Vestigios del antiguo juego ceremonial ubicado en las faldas del Puuc, donde actualmente se encuentra la Universidad Tecnológica del Poniente. Formaba parte de un importante centro ceremonial maya.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/juego-pelota.jpg",
      link: "#",
      tags: ["Deporte Ancestral", "Vestigios"]
    }
  ],
  
  naturaleza: [
    {
      id: 4,
      title: "Grutas de Maxcanú",
      description: "Numerosas grutas en el inicio de la zona Puuc, fueron refugio de antiguos mayas, fuente de agua pura para ceremonias y barro para vasijas. Se recomienda visitar las Grutas del Aguacate y de la Reina por su fácil acceso.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/grutas.jpg",
      link: "#",
      tags: ["Aventura", "Espeleología", "Guía"]
    },
    {
      id: 5,
      title: "Cerro de las Tres Cruces",
      description: "Cerro (Puuc) con capilla erigida como santuario de la Santa Cruz en su cima, las tres cruces fueron elaboradas con maderos de un árbol que estaba justo en el sitio. Ofrece vista panorámica del paisaje urbano desde la cima.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/tres-cruces.jpg",
      link: "#",
      tags: ["Mirador", "Vistas", "Capilla"]
    },
    {
      id: 6,
      title: "Cenote X-Corralcot",
      description: "Cenote ubicado a 20 kilómetros al norte de Maxcanú, para llegar se pasa por ex haciendas y ranchos, pudiendo observar flora y fauna local. Se requiere guía para acceder y extremar cuidados al meterse en él.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/cenote.jpg",
      link: "#",
      tags: ["Cenote", "Naturaleza", "Guía"]
    }
  ],
  
  cultura: [
    {
      id: 7,
      title: "Fiesta de San Miguel Arcángel",
      description: "Fiesta patronal del 7 al 29 de septiembre. Vaquerías, gremios, toros, procesiones y bailes tradicionales.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/fiesta-san-miguel.jpg",
      link: "#",
      tags: ["Fiesta", "Tradición", "Septiembre"]
    },
    {
      id: 8,
      title: "Janal Pixan (Hanal Pixán)",
      description: "Celebración de Finados que se realiza desde el 31 de octubre hasta el 2 de noviembre. Altares, comida tradicional y recorrido nocturno de leyendas.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/janal-pixan.jpg",
      link: "#",
      tags: ["Tradición", "Día de Muertos", "Cultura Maya"]
    },
    {
      id: 9,
      title: "Museo de Maxcanú",
      description: "Centro Cultural que alberga la riqueza arqueológica e histórica de la región. Antigua escuela Montessori.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/museo.jpg",
      link: "#",
      tags: ["Museo", "Historia", "Cultura"]
    }
  ],
  
  pueblos: [
    {
      id: 10,
      title: "Hacienda Santa Rosa",
      description: "Ex hacienda henequenera convertida en hotel exclusivo. Cuenta con jardín botánico de 9,200 m² y restaurante.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/hacienda-santa-rosa.jpg",
      link: "#",
      tags: ["Hacienda", "Lujo", "Jardín Botánico"]
    },
    {
      id: 11,
      title: "Pueblo Fantasma 'San Juan'",
      description: "Ex hacienda henequenera abandonada a 6km de Maxcanú. Ideal para fotografía y exploración urbana.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/san-juan.jpg",
      link: "#",
      tags: ["Abandonado", "Fotografía", "Aventura"]
    },
    {
      id: 12,
      title: "Chan Chocholá ('El Castillo')",
      description: "Hacienda con casa principal que parece castillo medieval. A poca distancia de Maxcanú en bici o caminando.",
      image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/chan-chochola.jpg",
      link: "#",
      tags: ["Arquitectura", "Hacienda", "Cercano"]
    }
  ]
};
---

<section
  id="inicio"
  class="min-h-[70vh] bg-cover bg-center bg-no-repeat flex items-center justify-center text-center relative pt-[70px]"
  style={`background-image: url('${imageUrl}');`}
>
  <div class="bg-black/50 absolute inset-0"></div>

  <div class="relative z-[2] text-white px-4">
    <h2 class="text-4xl md:text-5xl font-bold mb-2">{title}</h2>
    <p class="text-lg md:text-xl mb-6 max-w-2xl mx-auto leading-relaxed">{subtitle}</p>

    <div class="flex items-center justify-center gap-4 mt-6 flex-wrap">
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <a 
          href="#arqueologia" 
          class="px-6 py-3 rounded-xl bg-emerald-500 text-white font-bold shadow-lg hover:bg-emerald-400 hover:shadow-xl transition transform hover:-translate-y-1 flex items-center gap-2"
        >
        Arqueología e historia
        </a>

        <a 
          href="#naturaleza" 
          class="px-6 py-3 rounded-xl bg-blue-500 text-white font-bold shadow-lg hover:bg-blue-400 hover:shadow-xl transition transform hover:-translate-y-1 flex items-center gap-2"
        >
        Naturaleza y aventura
        </a>

        <a 
          href="#cultura" 
          class="px-6 py-3 rounded-xl bg-yellow-400 text-black font-bold shadow-lg hover:bg-yellow-300 hover:shadow-xl transition transform hover:-translate-y-1 flex items-center gap-2"
        >
        Cultura y Tradición
        </a>

        <a 
          href="#pueblos" 
          class="px-6 py-3 rounded-xl bg-orange-500 text-white font-bold shadow-lg hover:bg-orange-400 hover:shadow-xl transition transform hover:-translate-y-1 flex items-center gap-2"
        >
        Pueblos y haciendas cercanos
        </a>
      </div>
      <slot />
    </div>
  </div>
</section>

<section id="arqueologia" class="py-16 bg-gradient-to-b from-white to-emerald-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-emerald-800 mb-4">
        🏛️ Arqueología e Historia
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Sumérgete en el pasado maya y colonial de Maxcanú. Descubre antiguas ciudades, juegos rituales y el rico patrimonio histórico.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {atractivos.arqueologia.map((item) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-emerald-100">
          <div class="h-48 overflow-hidden">
            <img 
              src={item.image} 
              alt={item.title}
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <span class="text-3xl"></span>
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-semibold rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            
            <h3 class="text-xl font-bold text-gray-800 mb-3">{item.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed text-justify">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="naturaleza" class="py-16 bg-gradient-to-b from-white to-blue-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-blue-800 mb-4">
        🌿 Naturaleza y Aventura
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Explora el lado salvaje de Maxcanú. Desde cuevas milenarias hasta miradores espectaculares y cenotes sagrados.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {atractivos.naturaleza.map((item) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-blue-100">
          <div class="h-48 overflow-hidden">
            <img 
              src={item.image} 
              alt={item.title}
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="px-3 py-1 bg-blue-100 text-blue-700 text-xs font-semibold rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            
            <h3 class="text-xl font-bold text-gray-800 mb-3">{item.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed text-justify">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="cultura" class="py-16 bg-gradient-to-b from-white to-yellow-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-yellow-800 mb-4">
        🎭 Cultura y Tradición
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Vive las tradiciones vivas de Maxcanú. Festividades, rituales ancestrales y expresiones culturales que perduran.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {atractivos.cultura.map((item) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-yellow-100">
          <div class="h-48 overflow-hidden">
            <img 
              src={item.image} 
              alt={item.title}
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="px-3 py-1 bg-yellow-100 text-yellow-700 text-xs font-semibold rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            
            <h3 class="text-xl font-bold text-gray-800 mb-3">{item.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed text-justify">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section id="pueblos" class="py-16 bg-gradient-to-b from-white to-orange-50">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-orange-800 mb-4">
        🏘️ Pueblos y Haciendas Cercanas
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto">
        Descubre el legado henequenero y los pueblos con encanto que rodean Maxcanú. Historia, arquitectura y experiencias únicas.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {atractivos.pueblos.map((item) => (
        <div class="bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border border-orange-100">
          <div class="h-48 overflow-hidden">
            <img 
              src={item.image} 
              alt={item.title}
              class="w-full h-full object-cover hover:scale-105 transition duration-500"
            />
          </div>
          
          <div class="p-6">
            <div class="flex items-start justify-between mb-4">
              <div class="flex flex-wrap gap-2">
                {item.tags.map((tag) => (
                  <span class="px-3 py-1 bg-orange-100 text-orange-700 text-xs font-semibold rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </div>
            
            <h3 class="text-xl font-bold text-gray-800 mb-3">{item.title}</h3>
            <p class="text-gray-600 mb-6 leading-relaxed text-justify">{item.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<button
  id="scrollToTopBtn"
  class="fixed bottom-8 right-8 w-14 h-14 bg-emerald-500 text-white rounded-full shadow-2xl flex items-center justify-center opacity-0 invisible transition-all duration-300 hover:bg-emerald-600 hover:scale-110 active:scale-95 z-50 group"
  aria-label="Volver al inicio lentamente"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:-translate-y-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script>
  const scrollToTopBtn = document.getElementById('scrollToTopBtn');
  
  document.addEventListener('DOMContentLoaded', function() {
  const scrollToTopBtn = document.getElementById('scrollToTopBtn');
  
  if (!scrollToTopBtn) return;
  
  window.addEventListener('scroll', function() {
    if (window.scrollY > 300) {
      scrollToTopBtn.classList.remove('opacity-0', 'invisible');
      scrollToTopBtn.classList.add('opacity-100', 'visible');
    } else {
      scrollToTopBtn.classList.remove('opacity-100', 'visible');
      scrollToTopBtn.classList.add('opacity-0', 'invisible');
    }
  });
  
  scrollToTopBtn.addEventListener('click', function() {
    document.documentElement.style.scrollBehavior = 'smooth';
    
    window.scrollTo({
      top: 0,
      behavior: 'smooth'
    });
    
    setTimeout(() => {
      document.documentElement.style.scrollBehavior = '';
    }, 1000);
  });
});
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  
  section:target {
    scroll-margin-top: 80px;
  }
  
  #scrollToTopBtn {
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), 
                opacity 0.4s ease,
                visibility 0.4s ease,
                background-color 0.3s ease;
  }
  
  #scrollToTopBtn.visible {
    transform: translateY(0);
  }
</style>