---
const { 
  title = "Descubre los secretos de Maxcanú y la Ruta Puuc", 
  subtitle = "Explora grutas milenarias, haciendas históricas y la riqueza cultural de la región.", 
  imageUrl = "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivos/entrada_maxcanu.png" 
} = Astro.props;

const zonasInteres = [
  {
    id: "zonas-maxcanu",
    title: "Zonas de interés en Maxcanú",
    description: "Descubre los atractivos más importantes dentro de Maxcanú, desde sitios arqueológicos hasta tradiciones culturales vivas que definen la identidad de este pueblo mágico.",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/atractivos/palacio-maxcanu.webp",
    link: "/zonas-maxcanu",
    imageSide: "right"
  },
  {
    id: "zonas-alrededor", 
    title: "Zonas de interés alrededor de Maxcanú",
    description: "Explora los pueblos y haciendas cercanas a Maxcanú, testimonios del pasado henequenero y joyas arquitectónicas que rodean este destino turístico.",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/atractivos/hacienda-santa-rosa.webp",
    link: "/zonas-alrededor",
    imageSide: "left"
  },
  {
    id: "ruta-puuc",
    title: "Ruta Puuc",
    description: "Adéntrate en la famosa Ruta Puuc, corredor arqueológico y cultural que inicia en Maxcanú y conecta con algunos de los sitios mayas más impresionantes de Yucatán.",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/atractivos/oxkintok.webp",
    link: "/ruta-puuc",
    imageSide: "right"
  }
];
---

<section
  id="inicio"
  class="min-h-[90vh] bg-cover bg-center bg-no-repeat flex items-center justify-center text-center relative pt-[200px]"
  style={`background-image: url('${imageUrl}');`}
>
  <div class="bg-black/50 absolute inset-0"></div>

  <div class="relative z-[2] text-white px-4 w-full">
    <h2 class="text-4xl md:text-5xl font-bold mb-2">{title}</h2>
    <p class="text-lg md:text-xl mb-6 max-w-2xl mx-auto leading-relaxed text-center">{subtitle}</p>
    
    <slot />
  </div>
</section>

<section id="zonas-maxcanu" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <!-- Imagen a la derecha en desktop -->
      <div class="lg:w-1/2 lg:order-2">
        <div class="h-64 sm:h-72 md:h-80 lg:h-96 overflow-hidden rounded-2xl shadow-xl">
          <img 
            src={zonasInteres[0].image}
            alt={zonasInteres[0].title}
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="lg:w-1/2 lg:order-1">
        <div class="max-w-2xl mx-auto lg:mx-0">
          <h2 class="text-3xl md:text-4xl font-bold text-yellow-700 mb-4">
            {zonasInteres[0].title}
          </h2>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed text-justify">
            {zonasInteres[0].description}
          </p>
          <a 
            href={zonasInteres[0].link}
            class="inline-flex items-center gap-2 px-6 py-3 bg-yellow-700 text-white font-semibold rounded-lg hover:bg-yellow-800 hover:shadow-lg transition-all duration-300"
          >
            <span>Descubrir más</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="zonas-alrededor" class="py-16 bg-gray-50">
  <div class="container mx-auto px-4">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <div class="lg:w-1/2">
        <div class="h-64 sm:h-72 md:h-80 lg:h-96 overflow-hidden rounded-2xl shadow-xl">
          <img 
            src={zonasInteres[1].image}
            alt={zonasInteres[1].title}
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="lg:w-1/2">
        <div class="max-w-2xl mx-auto lg:mx-0">
          <h2 class="text-3xl md:text-4xl font-bold text-yellow-700 mb-4">
            {zonasInteres[1].title}
          </h2>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed text-justify">
            {zonasInteres[1].description}
          </p>
          <a 
            href={zonasInteres[1].link}
            class="inline-flex items-center gap-2 px-6 py-3 bg-yellow-700 text-white font-semibold rounded-lg hover:bg-yellow-800 hover:shadow-lg transition-all duration-300"
          >
            <span>Descubrir más</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="ruta-puuc" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12">
      <div class="lg:w-1/2 lg:order-2">
        <div class="h-64 sm:h-72 md:h-80 lg:h-96 overflow-hidden rounded-2xl shadow-xl">
          <img 
            src={zonasInteres[2].image}
            alt={zonasInteres[2].title}
            class="w-full h-full object-cover hover:scale-105 transition duration-500"
            loading="lazy"
          />
        </div>
      </div>
      
      <div class="lg:w-1/2 lg:order-1">
        <div class="max-w-2xl mx-auto lg:mx-0">
          <h2 class="text-3xl md:text-4xl font-bold text-yellow-700 mb-4">
            {zonasInteres[2].title}
          </h2>
          <p class="text-lg text-gray-600 mb-8 leading-relaxed text-justify">
            {zonasInteres[2].description}
          </p>
          <a 
            href={zonasInteres[2].link}
            class="inline-flex items-center gap-2 px-6 py-3 bg-yellow-700 text-white font-semibold rounded-lg hover:bg-yellow-800 hover:shadow-lg transition-all duration-300"
          >
            <span>Descubrir más</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<button
  id="scrollToTopBtn"
  class="fixed bottom-8 right-8 w-14 h-14 bg-white/10 backdrop-blur-lg text-white rounded-full shadow-xl hover:shadow-2xl flex items-center justify-center opacity-0 invisible transition-all duration-300 hover:scale-110 active:scale-95 z-50 group border border-white/20 hover:border-white/40"
  aria-label="Volver al inicio lentamente"
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:-translate-y-0.5 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
</button>

<script>
  // @ts-nocheck - Deshabilitar comprobación de TypeScript 
  function smoothScrollTo(targetPosition, duration = 1000) {
    const startPosition = window.pageYOffset;
    const distance = targetPosition - startPosition;
    let startTime = null;
    
    function animation(currentTime) {
      if (startTime === null) startTime = currentTime;
      const timeElapsed = currentTime - startTime;
      const progress = Math.min(timeElapsed / duration, 1);
      
      const easeOutCubic = function(t) {
        return 1 - Math.pow(1 - t, 3);
      };
      const easedProgress = easeOutCubic(progress);
      
      window.scrollTo(0, startPosition + (distance * easedProgress));
      
      if (timeElapsed < duration) {
        requestAnimationFrame(animation);
      }
    }
    
    requestAnimationFrame(animation);
  }
  
  document.addEventListener('DOMContentLoaded', function() {
    const scrollToTopBtn = document.getElementById('scrollToTopBtn');
    
    if (scrollToTopBtn) {
      window.addEventListener('scroll', function() {
        if (window.scrollY > 300) {
          scrollToTopBtn.classList.remove('opacity-0', 'invisible');
          scrollToTopBtn.classList.add('opacity-100', 'visible');
        } else {
          scrollToTopBtn.classList.remove('opacity-100', 'visible');
          scrollToTopBtn.classList.add('opacity-0', 'invisible');
        }
      });
      
      scrollToTopBtn.addEventListener('click', function() {
        smoothScrollTo(0, 1000);
      });
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
  
  section:target {
    scroll-margin-top: 80px;
  }
  
  #scrollToTopBtn {
    transform: translateY(20px);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), 
                opacity 0.4s ease,
                visibility 0.4s ease,
                background-color 0.3s ease;
  }
  
  #scrollToTopBtn.visible {
    transform: translateY(0);
  }
  
  .overflow-hidden img {
    transition: transform 0.5s ease;
  }
  
  .overflow-hidden:hover img {
    transform: scale(1.05);
  }
</style>