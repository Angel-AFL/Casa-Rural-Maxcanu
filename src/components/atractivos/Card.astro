---
// Card.astro - Componente para UNA tarjeta individual
const { 
  item,
  colorClass
} = Astro.props;
---

<div class={`bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border ${colorClass.border}`}>
  <div class="h-48 overflow-hidden">
    <img 
      src={item.image} 
      alt={item.title}
      class="w-full h-full object-cover hover:scale-105 transition duration-500"
    />
  </div>
  
  <div class="p-6">
    <div class="flex items-start justify-between mb-4">
      <span class="text-3xl"></span>
      <div class="flex flex-wrap gap-2">
        {item.tags.map((): any => (
          <span class={`px-3 py-1 ${colorClass.badge} text-xs font-semibold rounded-full`}>
            {}
          </span>
        ))}
      </div>
    </div>
    
    <h3 class="text-xl font-bold text-gray-800 mb-3">{item.title}</h3>
    <p class="text-gray-600 mb-6 leading-relaxed text-justify">{item.description}</p>
  </div>
</div>