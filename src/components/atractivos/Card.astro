---

// Card.astro - formato de la tarjeta individual
const { 
  item,
  colorClass
} = Astro.props;
---

<div class={`bg-white rounded-2xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 border ${colorClass.border} flex flex-col h-full`}>
  <!-- Imagen responsiva -->
  <div class="h-48 sm:h-56 md:h-64 lg:h-72 overflow-hidden flex-shrink-0">
    <img 
      src={item.image} 
      alt={item.title}
      class="w-full h-full object-cover hover:scale-105 transition duration-500"
      loading="lazy"
    />
  </div>
  
  <!-- Contenido de texto -->
  <div class="p-6 flex-grow flex flex-col">
    <div class="flex items-start justify-between mb-4">
      <!-- Aquí estaba el problema: espacio vacío que ocupaba lugar -->
      <div class="flex-1"></div>
      <div class="flex flex-wrap gap-2 justify-end">
        {item.tags.map((tag) => (
          <span class={`px-3 py-1 ${colorClass.badge} text-xs font-semibold rounded-full`}>
            {tag}
          </span>
        ))}
      </div>
    </div>
    
    <h3 class="text-xl font-bold text-gray-800 mb-3 flex-shrink-0">{item.title}</h3>
    <p class="text-gray-600 leading-relaxed text-justify flex-grow">{item.description}</p>
  </div>
</div>