---
import { getCatSalas } from "../../pages/api/cat_sala";
import { getHref } from "../../lib/utils";
import SalaCard from "../gallery/SalaCard.astro";

const cat_sala = await getCatSalas();
---

<section class="bg-palette-1 p-2 md:p-4 lg:p-8">
  <div class="grid gap-8 lg:grid-cols-3 md:grid-cols-2 place-items-center">
    {
      cat_sala?.map((sala) => (
        <SalaCard
          href={getHref(sala.nombre)}
          image={sala.imagen}
          name={sala.nombre}
        />
      ))
    }
  </div>
</section>
