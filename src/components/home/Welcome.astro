---
const title = "CASA RURAL MAXCANÚ";
const subtitle = "Bienvenidos a";
const texto="Un refugio auténtico donde la tradición maya, la naturaleza y la tranquilidad se encuentran para brindarte una experiencia inolvidable.";
const src="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/logos-png/logo-casa-rural-icono-negativo.png";
---

<section class="relative bg-palette-11 overflow-hidden py-20 rustic-paper rustic-shadow">

  <!-- Textura rústica -->
  <div class="rustic-overlay"></div>

  <!-- Motivos mayas -->
 <div class="absolute inset-0 flex justify-between pointer-events-none
            px-8 md:px-8 lg:px-8
            max-sm:px-4">

  <img 
   {src}
    alt="logo-negativo"
    aria-hidden="true"
    class="w-auto opacity-20
           max-sm:max-h-[20px]
           md:max-h-[40px]
           lg:max-h-none"
           width="80"
           height="80"
           loading="lazy"
  />

  <img 
    {src}
    alt="logo-negativo"
    aria-hidden="true"
    class="w-auto opacity-20
           max-sm:max-h-[20px]
           md:max-h-[40px]
           lg:max-h-none"
           width="80"
           height="80"
           loading="lazy"
  />

</div>

  <div class="relative max-w-5xl mx-auto text-center px-6">

    <p class="text-lg tracking-widest uppercase text-palette-2 mb-3">
      {subtitle}
    </p>

    <h1 class="text-4xl md:text-6xl font-extrabold tracking-widest text-palette-1 leading-tight">
      {title}
    </h1>

    <div class="flex justify-center mt-6">
      <span class="block w-32 h-1 bg-palette-7 rounded-full"></span>
    </div>

    <p class="mt-6 max-w-2xl mx-auto text-palette-5 text-base md:text-lg leading-relaxed">
      {texto}
    </p>

  </div>
</section>
