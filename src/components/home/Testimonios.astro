;0p\=---
const testimonios = [
  {
    texto: "El lugar es espectacular, rodeado de naturaleza y con espacios acogedores. Pasé un fin de semana increíble y sin duda regresaré pronto. La atención personalizada y el ambiente cálido hicieron toda la diferencia.",
    autor: "María López"
  },
  {
    texto: "Una experiencia maravillosa. Las habitaciones tienen un estilo rústico muy elegante, y todo está impecable. Me encantó poder descansar en un sitio tan tranquilo.",
    autor: "Carlos Pérez"
  },
  {
    texto: "El sitio es perfecto para desconectarse. La decoración, la limpieza y el trato fueron excepcionales. Lo recomiendo a todas las personas que buscan paz y comodidad.",
    autor: "Ana Martínez"
  },
    {
        texto: "Me encantó la combinación de lo rústico con lo moderno. La casa tiene mucho encanto y los alrededores son ideales para pasear y relajarse. Definitivamente volveré.",
        autor: "Luis García"
    },
    {
        texto: "Un lugar lleno de historia y cultura. Cada rincón tiene su propia historia, y el ambiente es muy acogedor. La atención del personal fue excelente.",
        autor: "Sofía Ramírez"
    },
    {
        texto: "La Casa Rural Maxcanú superó todas mis expectativas. La tranquilidad del lugar, la belleza de los jardines y la comodidad de las habitaciones hicieron que mi estancia fuera inolvidable.",
        autor: "Jorge Hernández"
    },{
        texto: "Un refugio perfecto para escapar del bullicio de la ciudad. La casa es hermosa y el entorno natural es impresionante. Me sentí renovada después de mi estancia.",
        autor: "Elena Torres"
    }
];
---
<section class="w-full py-12 md:py-16">

  <h2 class="text-center text-2xl sm:text-3xl md:text-4xl font-bold text-palette-5 
             mb-10 tracking-wide  py-4">
    Testimonios de Nuestros Visitantes
  </h2>

  <div class="relative max-w-[92rem] mx-auto px-8 sm:px-12 lg:px-16">

    <!-- Flecha izquierda -->
    <button id="prevBtn"
  class="absolute left-4 top-1/2 -translate-y-1/2 z-20
         w-11 h-11 rounded-full bg-white/70 backdrop-blur
         text-neutral-700 shadow-lg
         hover:bg-white hover:scale-105 transition
         flex items-center justify-center">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path d="M15 18l-6-6 6-6"/>
  </svg>
</button>

    <!-- Carrusel -->
    <div id="carousel"
      class="flex gap-8 overflow-hidden py-6">

      {testimonios.map((t) => (
        <article
          class="flex-shrink-0 w-[260px] lg:w-[280px] xl:w-[300px]
                 text-palette-5 p-7 rounded-2xl border border-neutral-700
                 shadow-md hover:shadow-xl transition-all duration-300">
          <p class="text-sm sm:text-base leading-relaxed opacity-90">
            “{t.texto}”
          </p>
          <p class="mt-6 font-semibold text-right">
            — {t.autor}
          </p>
        </article>
      ))}

    </div>

    <!-- Flecha derecha -->
    <button id="nextBtn"
  class="absolute right-4 top-1/2 -translate-y-1/2 z-20
         w-11 h-11 rounded-full bg-white/70 backdrop-blur
         text-neutral-700 shadow-lg
         hover:bg-white hover:scale-105 transition
         flex items-center justify-center">
  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
    <path d="M9 6l6 6-6 6"/>
  </svg>
</button>

  </div>

</section>
<script is:inline>
  const carousel = document.getElementById("carousel");
  const next = document.getElementById("nextBtn");
  const prev = document.getElementById("prevBtn");

  const gap = 32;
  const cardWidth = carousel.querySelector("article").offsetWidth + gap;

  let autoScroll;

  function startAutoScroll() {
    autoScroll = setInterval(moveNext, 3800);
  }

  function stopAutoScroll() {
    clearInterval(autoScroll);
  }

  function moveNext() {
    carousel.scrollBy({ left: cardWidth, behavior: "smooth" });

    if (carousel.scrollLeft + carousel.clientWidth >= carousel.scrollWidth - cardWidth) {
      setTimeout(() => carousel.scrollLeft = 0, 700);
    }
  }

  function movePrev() {
    carousel.scrollBy({ left: -cardWidth, behavior: "smooth" });
  }

  next.addEventListener("click", () => {
    stopAutoScroll();
    moveNext();
    startAutoScroll();
  });

  prev.addEventListener("click", () => {
    stopAutoScroll();
    movePrev();
    startAutoScroll();
  });

  startAutoScroll();
</script>

