---
const features = [
  {
    title: "Cocina equipada",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/cocina-maya.jpg",
  },
  {
    title: "biblioteca",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/biblioteca-estudio.png",
  },
  {
    title: "Estacionamiento",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/estacionamiento.png",
  },
  {
    title: "habitaciones con tematicas",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Oxkintok.png",
  },
  {
    title: "comedor al aire libre",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/comedor-2.png",
  },
  {
    title: "area de lavandería",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/lavadero.png",
  },
  {
    title: "jardin botanico",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/flores.jpg",
  },
  {
    title: "pinturas y esculturas",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/sala.png",
  }
  

];
---

<section class="w-full py-4 bg-white">
  <div class="max-w-7xl mx-auto px-4 text-center">
    
    <h2 class="text-3xl md:text-4xl font-semibold tracking-wide mb-2">
      Lo que ofrecemos 
    </h2>
    <p class="text-gray-500 mb-14">
      Comodidades pensadas para tu descanso y disfrute
    </p>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 p-8">
      {features.map((item) => (
        <div class="group cursor-pointer">

          <!-- CONTENEDOR DE TAMAÑO FIJO -->
          <div class="w-full h-36 md:h-40 flex items-center justify-center mb-5 overflow-hidden rounded-xl bg-gray-50">
            <img
              src={item.image}
              alt={item.title}
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
          </div>

          <h3 class="text-sm tracking-widest font-medium text-gray-800">
            {item.title.toUpperCase()}
          </h3>

        </div>
      ))}
    </div>
  </div>

  <div class="flex items-center justify-center gap-4 m-14">
    <slot/>
  </div>
</section>
