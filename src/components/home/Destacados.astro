---
const features = [
  {
    title: "Cocina equipada",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/inicio/cocina.webp",
    page: "/nosotros", 
    section: "cocina"
  },
  {
    title: "biblioteca",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/inicio/biblioteca-estudio.webp",
     page: "/nosotros", 
    section: "biblioteca"
  },
  {
    title: "Estacionamiento",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/inicio/estacionamiento.webp",
    page: "/nosotros",
    section: "estacionamiento"
  },
  {
    title: "Habitaciones con tematicas",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/cat-cabana-habitacion/habitacion-oxkintok.webp",
    page: "/hospedaje"
  },
  {
    title: "Comedores",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/inicio/comedor-2.webp",
    page: "/nosotros",
    section: "comedor1"
  },
  {
    title: "area de lavandería",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/inicio/lavadero.webp",
    page: "/nosotros",
    section: "lavadero"
  },
  {
    title: "Renta de bicicletas", 
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/atractivos/cerro-tres.cruces.webp",
    page: "/renta-de-bicicletas",
  },
  {
    title: "pinturas y esculturas",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/imagenes/inicio/sala.webp",
    page: "/galeria-de-arte",
    
  }
  

];
---

<section 
  class="w-full py-6 sm:py-10 bg-white mt-6 sm:mt-10"
  aria-labelledby="features-title"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
    
    <h2 
      id="features-title"
      class="text-2xl sm:text-3xl md:text-4xl font-semibold tracking-wide mb-4"
    >
      Lo que ofrecemos
    </h2>

   <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6 sm:gap-8 md:gap-10 py-6 sm:py-8">
  {features.map((item) => (
      
   <a
  href={item.page ? item.section ? `${item.page}#${item.section}` : item.page : "#"}
  class="group cursor-pointer focus:outline-none"
>

      <div class="w-full h-28 sm:h-32 md:h-40 flex items-center justify-center mb-4 sm:mb-5 overflow-hidden rounded-xl bg-gray-50 shadow-sm transition-shadow group-hover:shadow-md">
        <img
          src={item.image}
          alt={item.section}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
          
        />
        
      </div>

      <h3 class="text-xs sm:text-sm tracking-widest font-medium text-gray-800">
        {item.title.toUpperCase()}
      </h3>
    </a>

  ))}
</div>

  <div class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 mt-6 sm:mt-10 px-4">
    <slot/>
  </div>
</section>
