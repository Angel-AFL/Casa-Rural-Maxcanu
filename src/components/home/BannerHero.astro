---
const {

  videoUrl = "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/videos/CasaRural.mp4",
} = Astro.props;
---

<section 
  class="relative w-full overflow-hidden" 
  role="banner" 
  aria-label="Video de presentación de la página"
>
  <!-- Poster opcional mientras carga el video -->
  <video
    class="w-full h-full object-cover"
    src={videoUrl}
    autoplay
    muted
    loop
    playsinline
    
  >
    <track 
      kind="captions" 
      src="/ruta/a/captions.vtt" 
      srclang="es" 
      label="Español" 
    />
    Tu navegador no soporta videos HTML5.
  </video>

  
</section>
