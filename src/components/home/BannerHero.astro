---
const {

  videoUrl = "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/videos/CasaRural.mp4",
} = Astro.props;
---

<section
  class="relative w-full overflow-hidden"
  aria-label="Presentación principal del sitio"
>

  <!-- Contenido visible para SEO y accesibilidad -->
  <h1 class="sr-only">
    Bienvenido a nuestro sitio web — Experiencias únicas e innovación digital
  </h1>

  <video
    class="absolute inset-0 w-full h-full object-cover
           lg:relative lg:h-screen"
    src={videoUrl}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    aria-hidden="true"
  ></video>

</section>
s
