---
const { id, nombre, imagen, descripcion, descripcion_2 } = Astro.props;
---

<div class="relative inline-block card-with-modal">

  <!-- Imagen -->
  <img
    src={imagen}
    alt={nombre}
    class="w-[800px] h-[300px] rounded-xl object-cover shadow-md cursor-pointer hover:scale-105 transition-transform duration-300 open-modal-btn"
  />

  <!-- Modal -->
  <dialog class="art-card-dialog p-4 rounded-lg shadow-xl w-[70vw] max-w-lg m-auto overflow-hidden">
    <div class="flex flex-col items-center w-full max-w-lg"></div>

    <img src={imagen} alt={nombre} class="w-full h-auto max-h-[50vh] object-contain rounded-lg m-7" />

    <div class="p-6 w-full text-left">
      <h3 class="text-2xl font-bold text-emerald-700 mb-2 text-center">{nombre}</h3>

      <p class="text-stone-700 leading-relaxed break-words p-2 text-center w-auto">
        {descripcion}
      </p>

      <p class="text-stone-700 leading-relaxed break-words p-2 text-center w-auto">
        {descripcion_2}
      </p>
    </div>

    <button
      type="button"
      class="close-modal-btn absolute top-3 right-3 bg-black/60 hover:bg-black/80 text-white rounded-full w-8 h-8 flex items-center justify-center"
    >
      ✕
    </button>
  </dialog>
</div>



<style>
  .art-card-dialog::backdrop {
    background: rgba(9, 8, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  dialog.art-card-dialog {
    border: 10;
    padding: 10;
    max-width: 90%;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>
