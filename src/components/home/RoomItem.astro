---
const { id, nombre, imagen, descripcion } = Astro.props;
---

<div class="relative inline-block card-with-modal">
  <!-- Imagen de la habitación -->
  <img
    src={imagen}
    alt={nombre}
    class="w-80 h-60 rounded-xl object-cover shadow-md cursor-pointer hover:scale-105 transition-transform duration-300 open-modal-btn"
  />

  <!-- Modal que yo configure puede tener mejoras-->
  <dialog class=" art-card-dialog p-6 rounded-lg shadow-xl w-1/2 max-w-lg m-auto">
     <div class="flex flex-col items-center w-full max-w-lg"></div>
    <img src={imagen} alt={nombre} class="w-full h-auto max-h-[50vh] object-contain rounded-lg m-7" />
    <div class="p-6 w-full text-left">
        <h3 class="text-2xl font-bold text-emerald-700 mb-2 text-center">{nombre}</h3>
        <p class="text-stone-700 leading-relaxed break-words p-7 text-center w-auto">
          {descripcion}
        </p>
      </div>
    <button
      type="button"
      class="close-modal-btn absolute top-3 right-3 bg-black/60 hover:bg-black/80 text-white rounded-full w-8 h-8 flex items-center justify-center"
    >
      ✕
    </button>
  </dialog>
</div>
 <!-- Modal se migrara a ts por el momento error de ts -->
<script is:inline client:load>
  function setupModals() {
    const cards = document.querySelectorAll(".card-with-modal");

    cards.forEach((card) => {
      if (card.dataset.modalSetup === "true") return;

      const openBtn = card.querySelector(".open-modal-btn");
      const closeBtn = card.querySelector(".close-modal-btn");
      const dialog = card.querySelector("dialog.art-card-dialog");

      if (!dialog || !openBtn || !closeBtn) return;

      // Abrir modal
      openBtn.addEventListener("click", () => {
        if (typeof dialog.showModal === "function") {
          dialog.showModal();
        } else {
          alert("Tu navegador no soporta modales nativos.");
        }
      });

      // Cerrar modal con botón
      closeBtn.addEventListener("click", () => dialog.close());

      // Cerrar modal al hacer click fuera
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });

      // Marcar como configurado
      card.dataset.modalSetup = "true";
    });
  }

  // Inicializar
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupModals);
  } else {
    setupModals();
  }

  // Reconfigurar al cambiar de página en Astro SPA
  document.addEventListener("astro:page-load", setupModals);
</script>

<style>
  .art-card-dialog::backdrop {
    background: rgba(9, 8, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  dialog.art-card-dialog {
    border: 10;
    padding: 10;
    max-width: 90%;
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>
