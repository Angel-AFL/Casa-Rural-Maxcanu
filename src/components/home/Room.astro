---
import Habitacion from './RoomItem.astro';


const habitaciones = [
  {
    nombre: "OXKINTOK",
    imagen: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Oxkintok.png",
    
  },
  {
    nombre: "DOÑA CARMEN",
    imagen: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Carmen.png",
   
  },
  {
    nombre: "UXMAL",
    imagen: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Uxmal.png",
    
  },
  
  {
    nombre: "CELESTÚN",
    imagen: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Celestun.png",
   
},{
    nombre: "CABAÑAS: AVES TROPICALES",
    imagen: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Aves-Tropicales.png",
  },
  {
    nombre: "CABAÑAS: PITAHAYA-DRAGON FRUIT",
    imagen: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/PitahayaDragonFruit.png",
  }
];
---

<section class="bg-palette-4 py-16 text-stone-800 sm:py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4 text-center">
    <h2 class="text-3xl md:text-4xl font-bold text-emerald-700 mb-8 ">
       Habitaciones Y Cabañas 
    </h2>
  </div>

  <!-- Carrusel FULL WIDTH -->
  <div class="relative overflow-hidden w-full">
    <div class="flex animate-scroll gap-6 px-4">
      {habitaciones.map(h => (
        <div class="flex-shrink-0 w-80 card-with-modal">
          <Habitacion {...h} />
          
        </div>
      ))}

      {/* Duplicamos para loop infinito */}
      {habitaciones.map(h => (
        <div class="flex-shrink-0 w-[260px] sm:w-[300px] md:w-[340px] lg:w-[380px] card-with-modal">
          <Habitacion {...h} />
        </div>
      ))}
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
    <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg max-w-xl md:max-w-2xl mx-auto leading-relaxed">
      Cada habitación tiene su encanto, con detalles únicos que combinan comfort moderno y esencia yucateca.
    </p>
  </div>
  <div class="flex items-center justify-center gap-4 mt-8">
      <slot>
    </div>
  </div>
</section>

<style>
@keyframes scroll {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.animate-scroll {
  display: flex;
  width: max-content;
  animation: scroll 20s linear infinite;
}

.card-with-modal img {
  width: 100%;
  max-width: 820px;
  height: auto;
  border-radius: 1rem;
  transition: transform 0.3s ease;
}

.card-with-modal img:hover {
  transform: scale(1.05);
}
</style>
