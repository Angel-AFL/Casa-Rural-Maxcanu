---
import Layout from "../layouts/Layout.astro";
import Carrusel from "../components/hospedaje/Carrusel.astro";
import FormularioReact from "../components/hospedaje/FormularioReact.tsx";
import HabitacionesCabanas from "../components/hospedaje/HabitacionesCabanas..astro";
import { getCatCabanaHabitacion } from './api/nombre_cabana_habitacion';


const cabanas = await getCatCabanaHabitacion();
---

<Layout title="Hospedaje">
  <div class="bg-[#7F2E2C]">
    <!-- carrusel -->
    <Carrusel />
    <!-- cards -->
   <HabitacionesCabanas />
    <!-- formulario -->
    <FormularioReact cabanas={cabanas} client:load />
  </div>
</Layout>
