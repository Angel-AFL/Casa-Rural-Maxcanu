---
import Layout from "../layouts/Layout.astro";
import Room from "../components/home/Room.astro";
import Button from "../components/Button.astro";
import ImageWithText from "../components/ImageWithText.astro";
import Testimonios from "../components/home/Testimonios.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import Anuncio from "../components/home/Anuncio.astro";
import BannerHero from "../components/home/BannerHero.astro";
import Destacados from "../components/home/Destacados.astro";
import MapaUbicacion from "../components/home/MapaUbicacion.astro";
import Welcome from "../components/home/Welcome.astro";
import Resumen from "../components/home/ResumenAtractivos.astro";


const atractivosResumen = {
  arqueologia: {
    title: "Arqueología",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivo(1)/Oxkintok.jpg",
    description: "Sumérgete en el pasado maya y colonial de Maxcanú. Descubre antiguas ciudades, juegos rituales y el rico patrimonio histórico."
  },

  naturaleza: {
    title: "Naturaleza",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivo(1)/maxcanu_grutas.jpg",
    description: "Explora el lado salvaje de Maxcanú. Desde cuevas milenarias hasta miradores espectaculares y cenotes sagrados."
  },

  cultura: {
    title: "Cultura",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivo(1)/hanal_pixan.jpg",
    description: "Vive las tradiciones vivas de Maxcanú. Festividades, rituales ancestrales y expresiones culturales que perduran."
  },

  pueblos: {
    title: "Pueblos y Haciendas",
    image: "https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/atractivo(1)/hacienda_santa_rosa.jpg",
    description: "Descubre el legado henequenero y los pueblos con encanto que rodean Maxcanú. Historia, arquitectura y experiencias únicas."
  }
};

const colorClasses = {
  'arqueologia': {
    bg: 'from-white to-emerald-50',
    border: 'border-emerald-100',
    text: 'text-emerald-800',
    badge: 'bg-emerald-100 text-emerald-700'
  },
  'naturaleza': {
    bg: 'from-white to-blue-50',
    border: 'border-blue-100',
    text: 'text-blue-800',
    badge: 'bg-blue-100 text-blue-700'
  },
  'cultura': {
    bg: 'from-white to-yellow-50',
    border: 'border-yellow-100',
    text: 'text-yellow-800',
    badge: 'bg-yellow-100 text-yellow-700'
  },
  'pueblos': {
    bg: 'from-white to-orange-50',
    border: 'border-orange-100',
    text: 'text-orange-800',
    badge: 'bg-orange-100 text-orange-700'
  }
};
// 🔧 
const atractivosParaCard = Object.fromEntries(
  Object.entries(atractivosResumen).map(([key, item]) => [
    key,
    {
      ...item,
      description: "",
      tags: []
    }
  ])
);
const faqItems = [
  {
    question: "¿Cuál es el horario de check-in y check-out?",
    answer:
      "El check-in es a partir de las 15:00 y el check-out es antes de las 12:00. Si necesitas flexibilidad, contáctanos.",
  },
  {
    question: "¿Se admiten mascotas?",
    answer:
      "¡Sí! Somos 'pet-friendly'. Aceptamos mascotas bien educadas con un pequeño suplemento. Por favor, avísanos al reservar.",
  },
  {
    question: "¿La galería de arte tiene un costo extra?",
    answer:
      "No, el acceso a todas las salas de arte y jardines está incluido en tu estancia. La galería está abierta de 10:00 a 18:00.",
  },
  {
    question: "¿Hay Wi-Fi en las habitaciones?",
    answer:
      "Sí, ofrecemos conexión Wi-Fi gratuita de alta velocidad en todas las habitaciones y áreas comunes de la casa.",
  },
];



---

<Layout title="Casa Rural Maxcanú">
      
     <BannerHero/> 
      <Welcome/>
      <Destacados>
       <Button label="Más de nosotros" href="/../nosotros"/>
      </Destacados>
      <ImageWithText
      heading='"HISTORIA"'
      subheading="En los pueblos magicos cada sitio es son pedazos de historia yucateca"
      text="Este lugar es, en su totalidad, un pedazo de historia, cuyo encanto se manifiesta desde su cocina tradicional, que evoca la típica casa del Yucatán más antiguo, hasta su decoración, que resalta vivamente la cultura yucateca y otras influencias dejadas por personas internas y externas. Además, su jardín botánico alberga plantas locales con usos tradicionales de gran importancia para la herencia maya. En esencia, cada rincón de la casa tiene una historia que contar."
      imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/home/historia.png"
      imageSide="right"
      bgColor="bg-palette-15"
      textColor="text-palette-5"
      headingColor="text-palette-9"
      subheadingColor="text-palette-18"
      />
      
      <Room>
        <Button label="Ver Habitaciones" href="/hospedaje"/>
      </Room><ImageWithText
      heading='"HABITACIONES TEMÁTICAS"'
      subheading="Preservamos y compartimos la cultura yucateca pronoviendola con tematicas en las habitaciones y cabañas"
      text="En la Casa Rural Maxcanú, cada habitación y cabaña ha sido diseñada para ofrecer comodidad, tranquilidad y un toque artístico único. Todas cuentan con cama matrimonial, hamaca, ventilador, aire acondicionado, mesa de trabajo, clóset o ropero y pantalla con aplicaciones de entretenimiento como Netflix y YouTube, Cada espacio tiene una personalidad propia reflejada en su decoración artística, con colecciones temáticas que van desde mitos mayas y retratos, hasta flores, plantas y aves tropicales."
      imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_cabana_habitacion/Oxkintok.png"
      imageSide="right"
      bgColor="bg-palette-12"
      textColor="text-palette-5"
      headingColor="text-palette-8"
      subheadingColor="text-palette-18"
      />
      <Resumen atractivos={atractivosParaCard} colores={colorClasses} description="descripcion de prueba">
      <Button label="Explorar Atractivos" href="/mas-servicios"/>
      </Resumen>
      <Anuncio/>
       <MapaUbicacion/>
      <ImageWithText
      heading='"GALERIA DE ARTE"'
      subheading="El arte y la cultura son pilares fundamentales de Casa Rural Maxcanú"
      text="La Galería de Arte “Casa Rural Maxcanú” Comenzó con la decoración de algunos espacios de la Casa con obras de amigos pintores; varios años después siguió con la definición de 11 salas temáticas y se formalizó lacreación de la Galería de Arte el 15 de diciembre de 2023. "
      imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/plantas%20flores%20y%20frutos.png"
      imageSide="left"
      bgColor="bg-palette-13"
      textColor="text-palette-1"
      headingColor="text-palette-5"
      subheadingColor="text-palette-8"
      />
      <Testimonios/>
      <FaqAccordion items={faqItems}/>
    
    
</Layout>