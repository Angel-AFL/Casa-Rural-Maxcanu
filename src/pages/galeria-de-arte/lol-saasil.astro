---
import Layout from "../../layouts/Layout.astro";
import ArtCard from "../../components/galería/ArtCard.astro";
import Hero from "../../components/Hero.astro";
import { getLolSaasil } from "../api/cat_galeria_arte";

const catLolSaasil = await getLolSaasil();
---

<Layout title="Lol Saasil">
  <Hero
    title="Lol Saasil"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/lol%20saasil.png"
  />
  <section class="grid place-items-center p-2 md:p-4 lg:p-8">
    <div class="grid lg:grid-cols-4 md:grid-cols-3 gap-8 p-4">
      {catLolSaasil?.map((art) => <ArtCard {...art} />)}
    </div>
  </section>
</Layout>
