---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import ArtCard from "../../components/galería/ArtCard.astro";
import { getPasilloDeLaPLantaBaja } from "../api/cat_galeria_arte";
const catPasilloDeLaPlantaBaja = await getPasilloDeLaPLantaBaja();
---

<Layout title="Pasillo de la planta baja">
  <Hero
    title="Pasillo de la planta baja"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/pasillo%20de%20la%20planta%20baja.png"
  />
  <section class="grid place-items-center p-2 md:p-4 lg:p-8">
    <div class="grid lg:grid-cols-4 md:grid-cols-3 gap-8 p-4">
      {catPasilloDeLaPlantaBaja?.map((art) => <ArtCard {...art} />)}
    </div>
  </section>
</Layout>
