---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catFiguraHumana: CatGaleriaArte[] = await getArtsBySala("Figura humana");
---

<Layout title="Figura Humana">
  <Hero
    title="Figura Humana"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/figura%20humana.png"
  />
  <GridCards arts={catFiguraHumana} />
</Layout>
