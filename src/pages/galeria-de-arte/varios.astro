---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catVarios: CatGaleriaArte[] = await getArtsBySala("Varias");
---

<Layout title="Varios">
  <Hero
    title="Varios"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/pasillo%20de%20la%20planta%20baja.png"
  />
  <GridCards arts={catVarios} />
</Layout>
