---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catPitahayasDragonFruit: CatGaleriaArte[] = await getArtsBySala(
  "Pitahayas-Dragon fruit"
);
---

<Layout title="Pitahayas-Dragon fruit">
  <Hero
    title="Pitahayas-Dragon fruit"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/pitahayas-dragon-fruit.png"
  />
  <GridCards arts={catPitahayasDragonFruit} />
</Layout>
