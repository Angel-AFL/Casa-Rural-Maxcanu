---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catPlantasFloresYFrutos: CatGaleriaArte[] = await getArtsBySala(
  "Plantas, flores y frutos"
);
---

<Layout title="Plantas flores y frutos">
  <Hero
    title="Plantas flores y frutos"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/plantas%20flores%20y%20frutos.png"
  />
  <GridCards arts={catPlantasFloresYFrutos} />
</Layout>
