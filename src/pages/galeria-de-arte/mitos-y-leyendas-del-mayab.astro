---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catMitosYLeyendasDelMayab: CatGaleriaArte[] = await getArtsBySala(
  "Mitos y leyendas del Mayab"
);
---

<Layout title="Mitos y Leyendas del Mayab">
  <Hero
    title="Mitos y Leyendas del Mayab"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/mitos%20y%20leyendas%20del%20mayab.png"
  />
  <GridCards arts={catMitosYLeyendasDelMayab} />
</Layout>
