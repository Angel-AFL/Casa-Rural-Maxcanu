---
import Layout from "../../layouts/Layout.astro";
import ArtCard from "../../components/gallery/ArtCard.astro";
import Hero from "../../components/Hero.astro";
import { getPitahayasDeAdolfo } from "../api/cat_galeria_arte";

const catPitahayasDeAdolfo = await getPitahayasDeAdolfo();
---

<Layout title="Pitahayas de Adolfo">
  <Hero
    title="Pitahayas de Adolfo"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/pitahayas%20de%20adolfo.png"
  />
  <section class="grid place-items-center p-2 md:p-4 lg:p-8">
    <div class="grid lg:grid-cols-4 md:grid-cols-3 gap-8 p-4">
      {
        catPitahayasDeAdolfo?.map((art) => (
          <ArtCard
            img={art.imagen}
            name={art.nombre}
            author={art.autor}
            type={art.tipo}
          />
        ))
      }
    </div>
  </section>
</Layout>
