---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catPitahayasDeAdolfo: CatGaleriaArte[] = await getArtsBySala(
  "Pitahayas de Adolfo"
);
---

<Layout title="Pitahayas de Adolfo">
  <Hero
    title="Pitahayas de Adolfo"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/pitahayas%20de%20adolfo.png"
  />
  <GridCards arts={catPitahayasDeAdolfo} />
</Layout>
