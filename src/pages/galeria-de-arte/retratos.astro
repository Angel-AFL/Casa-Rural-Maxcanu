---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catRetratos: CatGaleriaArte[] = await getArtsBySala("Retratos");
---

<Layout title="Retratos">
  <Hero
    title="Retratos"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/retratos.png"
  />
  <GridCards arts={catRetratos} />
</Layout>
