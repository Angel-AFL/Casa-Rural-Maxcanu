---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catAvesTropicales: CatGaleriaArte[] =
  await getArtsBySala("Aves tropicales");
---

<Layout title="Aves Tropicales">
  <Hero
    title="Aves Tropicales"
    subtitle="Pinturas, esculturas y dibujos de distintos artistas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/aves%20tropicales.png"
  />
  <GridCards arts={catAvesTropicales} />
</Layout>
