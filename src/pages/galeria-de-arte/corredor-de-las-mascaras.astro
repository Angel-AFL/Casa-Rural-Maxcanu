---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catCorredorDeLasMascaras: CatGaleriaArte[] = await getArtsBySala(
  "Corredor de las máscaras"
);
---

<Layout title="Corredor de las máscaras">
  <Hero
    title="Corredor de las máscaras"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/corredor%20de%20las%20mascaras.png"
  />
  <GridCards arts={catCorredorDeLasMascaras} />
</Layout>
