---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catMujerMaya: CatGaleriaArte[] = await getArtsBySala("Mujer maya");
---

<Layout title="Mujer Maya">
  <Hero
    title="Mujer Maya"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/mujer%20maya.png"
  />
  <GridCards arts={catMujerMaya} />
</Layout>
