---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catCorredorDelPozo: CatGaleriaArte[] =
  await getArtsBySala("Corredor del pozo");
---

<Layout title="Corredor del pozo">
  <Hero
    title="Corredor del pozo"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/corredor.png"
  />
  <GridCards arts={catCorredorDelPozo} />
</Layout>
