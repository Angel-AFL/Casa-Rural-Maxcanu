---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import GridCards from "../../components/galería/GridCards.astro";
import { getArtsBySala } from "../../pages/api/cat_galeria_arte";
import type { CatGaleriaArte } from "../../types/global";

const catPalapaDeLasMariposas: CatGaleriaArte[] = await getArtsBySala(
  "Palapa de las mariposas"
);
---

<Layout title="Palapa de las Mariposas">
  <Hero
    title="Palapa de las mariposas"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/palapa%20de%20las%20mariposas.png"
  />
  <GridCards arts={catPalapaDeLasMariposas} />
</Layout>
