---
import Layout from "../../layouts/Layout.astro";
import ArtCard from "../../components/galería/ArtCard.astro";
import Hero from "../../components/Hero.astro";
import { getArtsBySala } from "../api/cat_galeria_arte";

const catPalapaDeLasMariposas = await getArtsBySala("Palapa de las mariposas");
---

<Layout title="Palapa de las Mariposas">
  <Hero
    title="Palapa de las mariposas"
    subtitle="Pinturas, esculturas y dibujos de distintos artístas y artesanos del sureste"
    imageUrl="https://jrrwlqhzxlfcsbaanzzq.supabase.co/storage/v1/object/public/images/cat_sala/palapa%20de%20las%20mariposas.png"
  />
  <section class="grid place-items-center p-2 md:p-4 lg:p-8">
    <div class="grid lg:grid-cols-4 md:grid-cols-3 gap-8 p-4">
      {catPalapaDeLasMariposas?.map((art) => <ArtCard {...art} />)}
    </div>
  </section>
</Layout>
